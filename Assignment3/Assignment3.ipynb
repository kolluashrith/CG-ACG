    "def runlen_encode(string):\n",
    "    i = 0\n",
    "    str_arr = []\n",
    "\n",
    "    while i < len(string):\n",
    "        curr = string[i]\n",
    "\n",
    "        count = 1\n",
    "        offset = i + 1\n",
    "\n",
    "        while offset < len(string) and string[offset] == curr:\n",
    "            count += 1\n",
    "            offset += 1\n",
    "\n",
    "        str_arr.append(f\"{curr}{count if count != 1 else ''}\")\n",
    "        i += count\n",
    "\n",
    "    return ''.join(str_arr)\n",
    "\n",
    "orig_len = len(text)\n",
    "\n",
    "orig_runlen_encoded = runlen_encode(text)\n",
    "orig_runlen = len(orig_runlen_encoded)\n",
    "\n",
    "BWT_runlen_encoded = runlen_encode(encoded_string)\n",
    "BWT_runlen = len(BWT_runlen_encoded)\n",
    "\n",
    "print(f\"The original string was {orig_len} chars long.\\nThe original string with runlength encoding was {orig_runlen} chars long.\\nThe BWT string with runlength encoding was {BWT_runlen} chars long.\")"
