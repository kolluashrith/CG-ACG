   "source": [
    "#Used ChatGPT to convert English instructions about how to plot the points per person different colors based on population into Python code.\n",
    "\n",
    "from sklearn.decomposition import PCA\n",
    "\n",
    "pca = PCA(n_components=2)\n",
    "\n",
    "X_pca = pca.fit_transform(X.iloc[:, 1:])\n",
    "\n",
    "# Population labels\n",
    "populations = y.values.ravel()\n",
    "\n",
    "# Plot\n",
    "plt.figure(figsize=(8, 6))\n",
    "\n",
    "for population in sorted(set(populations)):\n",
    "    mask = populations == population\n",
    "    plt.scatter(\n",
    "        X_pca[mask, 0],\n",
    "        X_pca[mask, 1],\n",
    "        label=population,\n",
    "        alpha=0.7\n",
    "    )\n",
    "\n",
    "plt.xlabel(f\"PC1 ({pca.explained_variance_ratio_[0] * 100:.2f}% variance)\")\n",
    "plt.ylabel(f\"PC2 ({pca.explained_variance_ratio_[1] * 100:.2f}% variance)\")\n",
    "plt.legend(title=\"Population\")\n",
    "plt.title(\"PCA of Labeled Genotypes\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
